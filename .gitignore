# ==========================================
# .gitignore - DOMIDELIS
# ==========================================

# --- Node.js / Dependencias ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json.md5

# --- Variables de entorno ---
.env
.env.local
.env.*.local
backend/.env

# --- Sistema Operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Editores / IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- Logs y temporales ---
logs/
*.log
*.tmp
*.temp
.cache/

# --- Futuros builds ---
dist/
build/
out/
.next/
.nuxt/

# --- Archivos que NO quieres ignorar ---
# *.pdf
# *.docx